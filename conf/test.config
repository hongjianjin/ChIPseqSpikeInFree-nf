/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Wiring test on placeholder (empty) BAMs; run it with -stub:

        nextflow run hongjianjin/ChIPseqSpikeInFree-nf -r main -profile test -stub --outdir results_test

    The test samplesheet lists the placeholder BAMs by their raw GitHub URLs,
    so the test runs from any launch directory (needs internet access).
----------------------------------------------------------------------------------------
*/

// Stub tasks need almost nothing; 1 CPU / 4 GB lets the test run with the local
// executor on a login or 1-core interactive node.
process {
    resourceLimits = [
        cpus: 1,
        memory: '4.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline wiring (use with -stub)'

    input  = "${projectDir}/assets/test_data/samplesheet_test.csv"
    cohort = 'test'
    genome = 'hg19'
}
