/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to the command in the module.
        ext.prefix = File name prefix for output files.
        ext.when   = Conditional clause
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Per-bigWig pseudo-counts are intermediate; the merged table is published by CSIF_MERGE_COUNTS.
    // Only the per-sample QC summary (JSON) is published, to <outdir>/bigwig_qc.
    // Genome, bin size, pseudo depth and summary mode are passed as inputs.
    withName: 'CSIF_BIN_BIGWIG' {
        publishDir = [
            path: { "${params.outdir}/bigwig_qc" },
            mode: params.publish_dir_mode,
            pattern: '*_bigwig_qc.json'
        ]
    }

    withName: 'CSIF_MERGE_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Parsing depends on the bin size. Calibration options are left at their defaults here
    // so that changing them re-runs only CSIF_SCALE.
    withName: 'CSIF_PARSE' {
        ext.args = { "--binSize ${params.bin_size}" }
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Scaling factors, QC calls and plots (replotting mode)
    withName: 'CSIF_SCALE' {
        ext.args = { [
            params.min_first_turn != null ? "--minFirstTurn ${params.min_first_turn}" : '',
            "--maxLastTurn ${params.max_last_turn}",
            "--cutoffQC ${params.cutoff_qc}",
            params.xmax != null ? "--xmax ${params.xmax}" : ''
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/scaling_factors" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
